DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=global-estate.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://global-estate.example.com
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_USE_MANIFEST_STATIC=True
